# LiveKit Cloud (from project settings or: lk appenv -w)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

# Google Gemini API (required — used for both Gemini native audio and text LLM)
GOOGLE_API_KEY=

# --- Optional: only needed when ttsProvider is set to "elevenlabs" ---

# Groq API (for STT — Whisper large-v3-turbo)
GROQ_API_KEY=

# ElevenLabs API (for TTS — eleven_flash_v2_5)
ELEVEN_API_KEY=

# ElevenLabs voice ID (optional, default: Lily — pFZP5JQG7iQjIQuC4Bku)
ELEVENLABS_VOICE_ID=
